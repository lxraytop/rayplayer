pkgname=ray-player-bin
pkgver=1.2.1
pkgrel=1
pkgdesc="Lyrics Reimagine desktop app packaged from prebuilt releases"
arch=('x86_64')
url="https://github.com/lxraytop/rayplayer"
license=('AGPL')
depends=(
  'alsa-lib'
  'gtk3'
  'libxss'
  'nss'
)
optdepends=(
  'xdg-utils: desktop integration helpers'
)
provides=('ray-player')
conflicts=('ray-player')
source=(
  "https://github.com/lxraytop/rayplayer/releases/download/v${pkgver}/ray-player-${pkgver}-linux-x64.tar.gz"
  'ray-player.desktop'
  'ray-player.png'
)
sha256sums=(
  'SKIP'
  '9dc6f7f25e6dc214cf8798e9df4d01829e2a832899313cc346e97c8db0e4c9ec'
  'cffe4a4fe5608706e2522de3b4cd8cc174357a9310493f107553794831312054'
)

package() {
  local appdir

  appdir="$(dirname "$(find "${srcdir}" -type f -name 'ray-player' -perm -u+x | head -n1)")"
  if [[ -z "${appdir}" ]]; then
    echo "Could not locate packaged ray-player executable in extracted archive" >&2
    return 1
  fi

  install -dm755 "${pkgdir}/opt/ray-player"
  cp -a "${appdir}/." "${pkgdir}/opt/ray-player/"

  install -dm755 "${pkgdir}/usr/bin"
  ln -sf "/opt/ray-player/ray-player" "${pkgdir}/usr/bin/ray-player"

  install -Dm644 "${srcdir}/ray-player.desktop" \
    "${pkgdir}/usr/share/applications/ray-player.desktop"
  install -Dm644 "${srcdir}/ray-player.png" "${pkgdir}/usr/share/pixmaps/ray-player.png"
}
