# 当前文件：Ray Docker Compose 的用户配置模板。
RAY_IMAGE_NAMESPACE=papersman

RAY_HTTP_BIND=0.0.0.0
RAY_HTTP_PORT=18080
RAY_AI_PROVIDER=google
RAY_FORWARD_CLIENT_IP=false
ENABLE_GENERAL_UNBLOCK=false

# 同时填写这两项后，QQ 登录态会加密保存到 qq-api-state 卷并跨重启恢复。
QQ_AUTH_SESSION_PATH=
QQ_SESSION_SECRET=

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
OPENAI_API_TEMPERATURE=0.7

RAY_SYNC_BIND=0.0.0.0
RAY_SYNC_PORT=13000
RAY_SYNC_DATA_DIR=./data/sync
SYNC_TOKEN=
DASHBOARD_TOKEN=
